{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reconcile",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-30",
  "secrets": { "required": ["ADMIN_PASSWORD"] },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reconcile-db",
      "database_id": "c9f862c9-aa0d-4bd5-bb33-d0fc807fc980",
      "migrations_dir": "migrations"
    }
  ]
}
