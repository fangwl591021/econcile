{
  "name": "econcile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "npm run build && node --test tests/*.test.mjs",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply reconcile-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply reconcile-db --remote"
  },
  "dependencies": {
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "vite": "7.1.7",
    "wrangler": "4.92.0"
  }
}
