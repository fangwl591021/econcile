{
  "name": "econcile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "npm run build && node --test tests/*.test.mjs",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply reconcile-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply reconcile-db --remote"
  },
  "dependencies": {
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "vite": "7.3.6",
    "wrangler": "4.115.0"
  }
}
